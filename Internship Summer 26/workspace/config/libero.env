# Primary standardized simulation benchmark.
LIBERO_BENCHMARK_ID=libero-long-v1
LIBERO_TASK_SUITE=libero_10
LIBERO_MODEL_ID=pi05_libero
LIBERO_CHECKPOINT_ID=gs://openpi-assets/checkpoints/pi05_libero
# The LIBERO preprocessing/model shape is also used to serve pi05_base during
# the post-training comparison; only the checkpoint changes for that pilot.
LIBERO_POLICY_CONFIG=pi05_libero
# pi05_base has no LIBERO statistics. For the base comparison, provision this
# preprocessing-only asset alongside the downloaded base weights.
LIBERO_NORMALIZATION_CHECKPOINT_ID=gs://openpi-assets/checkpoints/pi05_libero

LIBERO_SEED=7
LIBERO_REPLAN_STEPS=5
LIBERO_WAIT_STEPS=10
LIBERO_POLICY_RESOLUTION=224

# Collection profiles: 1 episode total, 10 episodes, and the published
# 10-tasks x 50-initial-states protocol respectively.
LIBERO_SMOKE_TRIALS=1
LIBERO_PILOT_TRIALS=1
LIBERO_FULL_TRIALS=50

LIBERO_PILOT_VIDEO_MODE=all
LIBERO_FULL_VIDEO_MODE=failures
LIBERO_STREAMING=0
LIBERO_STREAM_PORT=8090
LIBERO_LIVE_PREVIEW_EVERY=2
LIBERO_IMAGE=vla/libero-sim:2026-08-18
