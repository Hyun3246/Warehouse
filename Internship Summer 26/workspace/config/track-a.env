# Versioned defaults for the inference-only DROID Track A benchmark.
# Host-specific paths and GPU assignments stay in config/host.env.

TRACK_A_PROTOCOL=droid_sim_12
TRACK_A_BENCHMARK_ID=droid-sim-12task-v1
TRACK_A_MODEL_ID=pi05_droid
TRACK_A_CHECKPOINT_ID=gs://openpi-assets/checkpoints/pi05_droid
TRACK_A_CAMERA_PROFILE=external_cam_plus_wrist_224x224

# The currently installed pi05_droid checkpoint emits DROID joint velocities.
# A joint-position checkpoint will use a separate model ID and adapter.
TRACK_A_ACTION_MODE=joint_velocity
TRACK_A_OPEN_LOOP_HORIZON=8

# The published simulator comparison uses three trials for each of 12 prompts.
# Pilot collects one trial per prompt; full reproduces all 36 rollouts.
TRACK_A_PILOT_EPISODES=1
TRACK_A_FULL_EPISODES=3
TRACK_A_MAX_STEPS=450
TRACK_A_ORDER=sequential
TRACK_A_RANDOM_SEED=0

# This switch applies only to the secondary three-scene automatic benchmark.
# The primary 12-task protocol always requires qualitative video review.
TRACK_A_SCORING_VALIDATED=0

# Streaming is deliberately disabled for normal benchmark runs. Override with
# TRACK_A_STREAMING=1 for a run you want to watch from the WebRTC client.
TRACK_A_STREAMING=0
TRACK_A_STREAMING_MODE=2
