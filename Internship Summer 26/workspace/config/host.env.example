# Temporary no-sudo location. Replace with a directory on /data when an
# administrator provisions one.
VLA_DATA_ROOT=/home/julnk0207/vla-artifacts

# GPU 0 was occupied during the initial audit. Begin with one idle GPU and
# allocate other devices explicitly per workload.
VLA_GPU_IDS=1

# Keep caches on the large data disk.
HF_HOME=/home/julnk0207/vla-artifacts/cache/huggingface
UV_CACHE_DIR=/home/julnk0207/vla-artifacts/cache/uv
XDG_CACHE_HOME=/home/julnk0207/vla-artifacts/cache/xdg

# OpenPI / pi0.5-DROID inference defaults.
OPENPI_DATA_HOME=/home/julnk0207/vla-artifacts/cache/openpi
OPENPI_GPU_ID=1
OPENPI_PORT=8001
DROID_SIM_GPU_ID=2

# Optional Isaac Sim WebRTC mode: 2 for a private network/VPN, 1 only for a
# deliberately secured public endpoint. Track A keeps streaming off by default.
DROID_STREAMING_MODE=2
